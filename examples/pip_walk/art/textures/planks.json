{
  "format": "duckquill-script",
  "version": 1,
  "title": "Wood planks: 32 x 32, for the sides of a crate",
  "notes": "A Duck Quill script. Four planks with darker gaps between them, a lighter streak along each and two nails at each end. Make the PNG with: quill render planks.json --transparent --out .",
  "palette": {
    "wood": "#B07A3F",
    "light": "#C4915A",
    "gap": "#7A4E24",
    "nail": "#4A3018"
  },
  "commands": [
    { "cmd": "canvas", "width": 32, "height": 32, "pixel": true },
    { "cmd": "layer", "name": "Planks" },
    { "cmd": "rect", "x": 0, "y": 0, "width": 32, "height": 32, "fill": "wood" },
    { "cmd": "rect", "x": 0, "y": 7, "width": 32, "height": 1, "fill": "gap" },
    { "cmd": "rect", "x": 0, "y": 15, "width": 32, "height": 1, "fill": "gap" },
    { "cmd": "rect", "x": 0, "y": 23, "width": 32, "height": 1, "fill": "gap" },
    { "cmd": "rect", "x": 0, "y": 31, "width": 32, "height": 1, "fill": "gap" },
    { "cmd": "layer", "name": "Grain" },
    { "cmd": "rect", "x": 5, "y": 2, "width": 13, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 21, "y": 4, "width": 7, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 12, "y": 10, "width": 15, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 4, "y": 12, "width": 6, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 6, "y": 18, "width": 10, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 19, "y": 20, "width": 9, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 9, "y": 26, "width": 16, "height": 1, "fill": "light" },
    { "cmd": "rect", "x": 4, "y": 28, "width": 5, "height": 1, "fill": "light" },
    { "cmd": "layer", "name": "Nails" },
    { "cmd": "pixels", "at": [1, 3], "colors": { "n": "nail" }, "rows": ["n", ".", ".", ".", ".", ".", ".", ".", "n", ".", ".", ".", ".", ".", ".", ".", "n", ".", ".", ".", ".", ".", ".", ".", "n"] },
    { "cmd": "pixels", "at": [30, 3], "colors": { "n": "nail" }, "rows": ["n", ".", ".", ".", ".", ".", ".", ".", "n", ".", ".", ".", ".", ".", ".", ".", "n", ".", ".", ".", ".", ".", ".", ".", "n"] }
  ]
}
