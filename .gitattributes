# Windows scripts need Windows line endings to run, and shell scripts
# need plain \n ones (in Git Bash or WSL on Windows, too).
*.bat text eol=crlf
*.iss text eol=crlf
*.sh text eol=lf

# Models (Duck Mold .glb files) are bytes, never text.
*.glb binary

# Sounds and pictures are bytes too.
*.wav binary
*.png binary
